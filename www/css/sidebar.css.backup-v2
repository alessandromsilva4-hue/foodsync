/* =========================================================
   LOTRIX — SIDEBAR V2
   Visual profissional / Drawer responsivo
========================================================= */

* {
    box-sizing: border-box;
}

/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
    position: fixed !important;
    inset: 0 auto 0 0 !important;

    width: 264px !important;
    height: 100vh !important;
    height: 100dvh !important;

    display: flex !important;
    flex-direction: column !important;

    margin: 0 !important;
    padding: 0 !important;

    background: #064e3b !important;
    color: #ffffff !important;

    z-index: 99999 !important;

    overflow: hidden !important;

    transform: translateX(-100%) !important;
    transition: transform .25s ease, box-shadow .25s ease !important;
}

.sidebar.open {
    transform: translateX(0) !important;

    box-shadow:
        8px 0 30px rgba(0, 0, 0, .22) !important;
}

/* =========================================================
   CABEÇALHO / LOGO
========================================================= */

.sidebar > .logo-area {
    position: relative !important;

    flex: 0 0 auto !important;

    width: 100% !important;

    min-height: 86px !important;

    margin: 0 !important;
    padding: 18px 58px 14px 20px !important;

    text-align: left !important;

    border-bottom: 1px solid rgba(255, 255, 255, .08) !important;

    overflow: hidden !important;
}

.sidebar > .logo-area img {
    display: none !important;
}

.sidebar > .logo-area h2 {
    margin: 0 !important;

    color: #ffffff !important;

    font-size: 21px !important;
    line-height: 24px !important;

    font-weight: 800 !important;

    letter-spacing: .5px !important;
}

.sidebar > .logo-area small {
    display: block !important;

    margin-top: 3px !important;

    color: #bbf7d0 !important;

    font-size: 10px !important;
    line-height: 13px !important;

    font-weight: 500 !important;

    letter-spacing: .2px !important;
}

/* =========================================================
   BOTÃO FECHAR
========================================================= */

.sidebar-close {
    position: absolute !important;

    top: 17px !important;
    right: 15px !important;

    width: 34px !important;
    height: 34px !important;

    display: grid !important;
    place-items: center !important;

    padding: 0 !important;

    border: 1px solid rgba(255, 255, 255, .14) !important;
    border-radius: 9px !important;

    background: rgba(255, 255, 255, .07) !important;

    color: #ffffff !important;

    font-size: 21px !important;
    line-height: 1 !important;

    cursor: pointer !important;

    z-index: 10 !important;

    transition:
        background .18s ease,
        border-color .18s ease,
        transform .18s ease !important;
}

.sidebar-close:hover {
    background: rgba(255, 255, 255, .14) !important;

    border-color: rgba(255, 255, 255, .25) !important;

    transform: scale(1.04) !important;
}

/* =========================================================
   MENU
========================================================= */

.sidebar > .menu {
    flex: 1 1 auto !important;

    width: 100% !important;

    min-height: 0 !important;

    margin: 0 !important;

    padding: 16px 12px !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;
}

/* =========================================================
   SEÇÕES
========================================================= */

.sidebar .menu-section {
    width: 100% !important;

    margin: 0 0 17px !important;
    padding: 0 !important;
}

.sidebar .menu-section:last-child {
    margin-bottom: 0 !important;
}

/* =========================================================
   TÍTULOS DAS SEÇÕES
========================================================= */

.sidebar .menu-title {
    display: block !important;

    width: 100% !important;

    margin: 0 0 6px !important;

    padding: 0 10px !important;

    color: #86efac !important;

    font-size: 9px !important;
    line-height: 12px !important;

    font-weight: 700 !important;

    letter-spacing: 1.15px !important;

    text-transform: uppercase !important;
}

/* =========================================================
   LINKS
========================================================= */

.sidebar .menu a {
    position: relative !important;

    display: flex !important;

    align-items: center !important;

    width: 100% !important;

    min-height: 38px !important;
    height: 38px !important;

    margin: 0 0 3px !important;

    padding: 0 11px !important;

    gap: 11px !important;

    border-radius: 8px !important;

    background: transparent !important;

    color: #ecfdf5 !important;

    text-decoration: none !important;

    font-size: 13px !important;
    line-height: 18px !important;

    font-weight: 500 !important;

    transition:
        background .18s ease,
        color .18s ease,
        transform .18s ease !important;
}

/* =========================================================
   ÍCONES LUCIDE
========================================================= */

.sidebar .menu a > i,
.sidebar .menu a > svg {
    flex: 0 0 18px !important;

    width: 18px !important;
    height: 18px !important;

    stroke-width: 1.9 !important;

    color: #bbf7d0 !important;

    transition:
        color .18s ease,
        transform .18s ease !important;
}

.sidebar .menu a .nav-label {
    flex: 1 1 auto !important;

    width: auto !important;
    min-width: 0 !important;
    max-width: none !important;

    margin: 0 !important;

    overflow: hidden !important;

    white-space: nowrap !important;

    text-overflow: ellipsis !important;
}

/* =========================================================
   HOVER
========================================================= */

.sidebar .menu a:hover {
    background: rgba(255, 255, 255, .075) !important;

    color: #ffffff !important;

    transform: translateX(2px) !important;
}

.sidebar .menu a:hover > i,
.sidebar .menu a:hover > svg {
    color: #ffffff !important;

    transform: scale(1.05) !important;
}

/* =========================================================
   ITEM ATIVO
========================================================= */

.sidebar .menu a.active {
    background: rgba(74, 222, 128, .17) !important;

    color: #ffffff !important;

    font-weight: 700 !important;

    box-shadow:
        inset 3px 0 0 #4ade80 !important;
}

.sidebar .menu a.active > i,
.sidebar .menu a.active > svg {
    color: #4ade80 !important;
}

/* =========================================================
   ITENS SEM PERMISSÃO
========================================================= */

.sidebar .menu a[hidden],
.sidebar .menu-section[hidden] {
    display: none !important;
}

/* =========================================================
   RODAPÉ
========================================================= */

.sidebar > .sidebar-footer {
    flex: 0 0 auto !important;

    width: 100% !important;

    min-height: 91px !important;

    margin: 0 !important;

    padding: 12px 12px !important;

    border-top: 1px solid rgba(255, 255, 255, .09) !important;

    background: rgba(0, 0, 0, .07) !important;

    overflow: hidden !important;
}

/* =========================================================
   CARTÃO DO USUÁRIO
========================================================= */

.sidebar .user-card {
    display: flex !important;

    align-items: center !important;

    width: 100% !important;

    min-width: 0 !important;

    gap: 9px !important;

    margin: 0 !important;

    padding: 0 !important;
}

/* =========================================================
   AVATAR
========================================================= */

.sidebar .user-card .avatar {
    flex: 0 0 34px !important;

    width: 34px !important;
    height: 34px !important;

    display: grid !important;
    place-items: center !important;

    border-radius: 50% !important;

    background: rgba(255, 255, 255, .12) !important;

    color: #ffffff !important;

    font-size: 15px !important;
}

/* =========================================================
   DADOS DO USUÁRIO
========================================================= */

.sidebar .user-card > div:last-child {
    flex: 1 1 auto !important;

    min-width: 0 !important;

    overflow: hidden !important;
}

.sidebar .sidebar-footer strong {
    display: block !important;

    width: 100% !important;

    margin: 0 !important;

    color: #ffffff !important;

    font-size: 11px !important;
    line-height: 15px !important;

    font-weight: 700 !important;

    white-space: nowrap !important;

    overflow: hidden !important;

    text-overflow: ellipsis !important;
}

.sidebar .sidebar-footer small {
    display: block !important;

    margin: 1px 0 0 !important;

    color: #bbf7d0 !important;

    font-size: 9px !important;
    line-height: 12px !important;

    white-space: nowrap !important;

    overflow: hidden !important;

    text-overflow: ellipsis !important;
}

/* =========================================================
   BOTÃO SAIR
========================================================= */

.sidebar .sidebar-footer > button {
    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;

    height: 30px !important;

    margin: 8px 0 0 !important;

    padding: 0 8px !important;

    border: 0 !important;

    border-radius: 7px !important;

    background: rgba(255, 255, 255, .055) !important;

    color: #d1fae5 !important;

    font-size: 10px !important;

    cursor: pointer !important;

    transition: background .18s ease, color .18s ease !important;
}

.sidebar .sidebar-footer > button:hover {
    background: rgba(255, 255, 255, .11) !important;

    color: #ffffff !important;
}

/* =========================================================
   BOTÃO MENU
========================================================= */

.menu-toggle {
    position: fixed !important;

    top: 18px !important;
    left: 18px !important;

    width: 40px !important;
    height: 40px !important;

    display: grid !important;
    place-items: center !important;

    padding: 0 !important;

    border: 0 !important;
    border-radius: 10px !important;

    background: #15803d !important;

    color: #ffffff !important;

    font-size: 20px !important;
    line-height: 1 !important;

    cursor: pointer !important;

    z-index: 2147483647 !important;

    box-shadow:
        0 4px 14px rgba(15, 23, 42, .22) !important;
}

.menu-toggle:hover {
    background: #166534 !important;
}

/* =========================================================
   ESCONDER BOTÃO QUANDO MENU ESTÁ ABERTO
========================================================= */

.sidebar.open ~ .menu-toggle,
.sidebar.open + .menu-toggle {
    visibility: hidden !important;

    pointer-events: none !important;
}

/* =========================================================
   OVERLAY
========================================================= */

.sidebar-overlay {
    position: fixed !important;

    inset: 0 !important;

    background: rgba(15, 23, 42, .48) !important;

    visibility: hidden !important;

    opacity: 0 !important;

    transition:
        opacity .25s ease,
        visibility .25s ease !important;

    z-index: 99998 !important;
}

.sidebar-overlay.active {
    visibility: visible !important;

    opacity: 1 !important;
}

/* =========================================================
   CONTEÚDO
========================================================= */

.content {
    margin-left: 0 !important;

    width: 100% !important;

    min-height: 100vh !important;

    box-sizing: border-box !important;
}

/* =========================================================
   SCROLLBAR
========================================================= */

.sidebar > .menu::-webkit-scrollbar {
    width: 4px;
}

.sidebar > .menu::-webkit-scrollbar-track {
    background: transparent;
}

.sidebar > .menu::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, .18);

    border-radius: 10px;
}

/* =========================================================
   TABLET / DESKTOP
========================================================= */

@media (min-width: 901px) {

    .sidebar {
        transform: translateX(0) !important;
    }

    .menu-toggle {
        display: none !important;
    }

    .sidebar-close {
        display: none !important;
    }

    .sidebar-overlay {
        display: none !important;
    }

    .content {
        margin-left: 264px !important;

        width: calc(100% - 264px) !important;
    }
}

/* =========================================================
   TABLET
========================================================= */

@media (min-width: 641px) and (max-width: 900px) {

    .sidebar {
        width: 264px !important;
    }

    .content {
        margin-left: 0 !important;

        width: 100% !important;
    }
}

/* =========================================================
   CELULAR
========================================================= */

@media (max-width: 640px) {

    .sidebar {
        width: min(86vw, 280px) !important;
    }

    .sidebar > .logo-area {
        padding-left: 18px !important;
    }

    .sidebar > .menu {
        padding: 14px 10px !important;
    }

    .sidebar .menu a {
        min-height: 40px !important;

        height: 40px !important;
    }

    .sidebar .menu-section {
        margin-bottom: 14px !important;
    }

    .content {
        margin-left: 0 !important;

        width: 100% !important;

        padding-top: 0 !important;
    }
}

/* =========================================================
   ACESSIBILIDADE
========================================================= */

.sidebar a:focus-visible,
.sidebar button:focus-visible,
.menu-toggle:focus-visible {
    outline: 2px solid #86efac !important;

    outline-offset: 2px !important;
}

/* =========================================================
   MICROINTERAÇÕES
========================================================= */

.sidebar .menu a,
.sidebar button,
.menu-toggle {
    -webkit-tap-highlight-color: transparent;
}