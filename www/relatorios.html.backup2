<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>Lotrix - Relatórios</title>


<link rel="icon" href="img/favicon.png">


<link rel="stylesheet" href="css/style.css">

<link rel="stylesheet" href="css/sidebar.css">

<link rel="stylesheet" href="css/tabela.css">


</head>



<body>


<div class="layout">



<aside class="sidebar">

    <div class="logo-area">
        <img src="img/logo.png" alt="Lotrix">
        <h2>LOTRIX</h2>
        <small>Food Safety Platform</small>
    </div>

    <nav class="menu">

        <div class="menu-section">
            <span class="menu-title">GERAL</span>

            <a href="dashboard.html" class="active">
                <span>🏠</span>
                <span class="nav-label">Dashboard</span>
            </a>
        </div>

        <div class="menu-section">
            <span class="menu-title">OPERAÇÃO</span>

            <a href="producao.html">
                <span>⚙️</span>
                <span class="nav-label">Produção</span>
            </a>

            <a href="produtos.html">
                <span>📦</span>
                <span class="nav-label">Produtos</span>
            </a>

            <a href="etiquetas.html">
                <span>🏷️</span>
                <span class="nav-label">Etiquetas</span>
            </a>

            <a href="estoque.html">
                <span>📚</span>
                <span class="nav-label">Estoque</span>
            </a>
        </div>

        <div class="menu-section">
            <span class="menu-title">GESTÃO</span>

            <a href="relatorios.html">
                <span>📈</span>
                <span class="nav-label">Relatórios</span>
            </a>

            <a href="auditoria.html">
                <span>📝</span>
                <span class="nav-label">Auditoria</span>
            </a>

            <a href="usuario.html">
                <span>👥</span>
                <span class="nav-label">Usuários</span>
            </a>
        </div>

        <div class="menu-section">
            <span class="menu-title">SISTEMA</span>

            <a href="configuracoes.html">
                <span>⚙️</span>
                <span class="nav-label">Configurações</span>
            </a>

            <a href="ajuda.html">
                <span>❓</span>
                <span class="nav-label">Ajuda</span>
            </a>

            <a href="sac.html">
                <span>🎧</span>
                <span class="nav-label">SAC</span>
            </a>
        </div>

    </nav>

    <div class="user-card">

    <div class="avatar">
        👤
    </div>

    <div>
        <strong id="nomeUsuarioLogado">
            Usuário
        </strong>

        <small id="perfilUsuarioLogado">
            Carregando...
        </small>
    </div>

</div>

        <button onclick="logout()">
            🚪 Sair
        </button>

    </div>

</aside>









<main class="content">



<header class="top-header">


<div>


<h1>
Relatórios
</h1>


<p>
Análise dos dados do Lotrix
</p>


</div>


</header>


<div class="acoes-relatorio">

<button onclick="exportarExcel()">
📊 Exportar Excel
</button>


<button onclick="exportarCSV()">
📄 Exportar CSV
</button>


<button onclick="imprimirRelatorio()">
🖨️ Imprimir
</button>

</div>





<section class="cards">



<div class="card">


<div class="card-icon">

🍱

</div>


<div>


<h3>
Produções
</h3>


<strong id="totalProducoes">

0

</strong>


</div>


</div>






<div class="card">


<div class="card-icon">

🏷️

</div>


<div>


<h3>
Etiquetas
</h3>


<strong id="totalEtiquetas">

0

</strong>


</div>


</div>







<div class="card">


<div class="card-icon">

📦

</div>


<div>


<h3>
Produtos
</h3>


<strong id="totalProdutos">

0

</strong>


</div>


</div>







<div class="card">


<div class="card-icon">

⚠️

</div>


<div>


<h3>
Estoque Baixo
</h3>


<strong id="totalEstoqueBaixo">

0

</strong>


</div>


</div>



</section>

<section class="table-box">

<h2>
📊 Produção por Produto
</h2>

<canvas id="graficoProducao"></canvas>

</section>






<section class="table-box">


<h2>
Últimas Produções
</h2>




<table>


<thead>


<tr>


<th>
Produto
</th>


<th>
Quantidade
</th>


<th>
Responsável
</th>


<th>
Data
</th>


</tr>


</thead>




<tbody id="relatorioProducao">


<tr>

<td colspan="4">

Sem dados

</td>


</tr>


</tbody>




</table>


</section>








</main>


</div>





<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script type="module" src="js/firebase.js"></script>

<script type="module" src="js/app.js"></script>

<script type="module" src="js/relatorios.js"></script>

<script type="module" src="js/auth.js"></script>



</body>

</html>

