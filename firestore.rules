rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================
    // FUNÇÕES GERAIS
    // =====================================

    function usuarioLogado() {
      return request.auth != null;
    }

    function perfilUsuario() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      );
    }

    function usuarioAtivo() {
      return usuarioLogado()
        &&
        perfilUsuario().data.status == "ativo";
    }

    function administrador() {
      return usuarioAtivo()
        &&
        (
          perfilUsuario().data.perfil == "administrador"
          ||
          perfilUsuario().data.perfil == "Administrador"
        );
    }

    function idEmpresaUsuario() {
      return perfilUsuario().data.idEmpresa;
    }

    function tokenPrinterService(empresaId) {
      return get(
        /databases/$(database)/documents/printerServicePairings/$(empresaId)
      ).data.token;
    }

    function registroPrinterServiceValido(empresaId) {
      let token = tokenPrinterService(empresaId);
      let registro = getAfter(
        /databases/$(database)/documents/printerServiceUpdates/$(empresaId)/services/$(token)
      );
      return token is string
        && registro.data.idEmpresa == empresaId
        && registro.data.host == request.resource.data.host
        && registro.data.port == request.resource.data.port
        && registro.data.lastSeenAt == request.resource.data.lastSeenAt;
    }


    // =====================================
    // PRODUTOS
    // =====================================

    match /produtos/{produtoId} {

      allow read: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in resource.data.empresas;

      allow create: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in request.resource.data.empresas;

      allow update: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in resource.data.empresas
        &&
        idEmpresaUsuario() in request.resource.data.empresas;

      allow delete: if
        administrador()
        &&
        idEmpresaUsuario() in resource.data.empresas;
    }


    // =====================================
    // ESTOQUE
    // =====================================

    match /estoque/{estoqueId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // PRODUÇÕES
    // =====================================

    match /producoes/{producaoId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // MOVIMENTAÇÕES
    // =====================================

    match /movimentacoes/{movimentacaoId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // ETIQUETAS
    // =====================================

    match /etiquetas/{etiquetaId} {

      // Usuário ativo só enxerga etiquetas
      // pertencentes à própria empresa.
      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();

      // Criação somente dentro da própria empresa.
      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      // Alteração somente dentro da própria empresa.
      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      // EXCLUSÃO:
      // somente administrador ativo
      // e somente etiquetas da própria empresa.
      allow delete: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // CONSULTAS PÚBLICAS
    // =====================================

    match /consultasPublicas/{codigoEtiqueta} {

      allow read: if true;

      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update, delete: if false;
    }


    // =====================================
    // AUDITORIA
    // =====================================

    match /auditoria/{auditoriaId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // SAC
    // =====================================

    match /sac/{chamadoId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.usuarioId == request.auth.uid;

      allow update: if
        administrador()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if false;
    }


    // =====================================
    // USUÁRIOS
    // =====================================

    match /usuarios/{userId} {

      // -----------------------------------
      // LEITURA
      // -----------------------------------

      allow read: if
        usuarioLogado()
        &&
        (
          userId == request.auth.uid
          ||
          (
            usuarioAtivo()
            &&
            resource.data.idEmpresa == idEmpresaUsuario()
          )
        );


      // -----------------------------------
      // CRIAÇÃO PELO PRÓPRIO USUÁRIO
      // -----------------------------------

      allow create: if
        usuarioLogado()
        &&
        userId == request.auth.uid
        &&
        request.resource.data.status == "pendente"
        &&
        request.resource.data.perfil == "colaborador"
        &&
        request.resource.data.idEmpresa is string
        &&
        request.resource.data.idEmpresa != "";


      // -----------------------------------
      // ADMIN CRIA USUÁRIO
      // -----------------------------------

      allow create: if
        administrador()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.perfil != "administrador"
        &&
        request.resource.data.perfil != "Administrador";


      // -----------------------------------
      // ATUALIZAÇÃO
      // -----------------------------------

      allow update: if
        (
          usuarioLogado()
          &&
          userId == request.auth.uid
          &&
          resource.data.idEmpresa ==
            request.resource.data.idEmpresa
          &&
          resource.data.status ==
            request.resource.data.status
          &&
          resource.data.perfil ==
            request.resource.data.perfil
          &&
          resource.data.permissoes ==
            request.resource.data.permissoes
          &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nome",
              "email",
              "atualizadoEm"
            ])
        )

        ||

        (
          administrador()
          &&
          resource.data.idEmpresa ==
            idEmpresaUsuario()
          &&
          request.resource.data.idEmpresa ==
            idEmpresaUsuario()
        );


      // -----------------------------------
      // EXCLUSÃO
      // -----------------------------------

      allow delete: if
        administrador()
        &&
        resource.data.idEmpresa ==
          idEmpresaUsuario();
    }


    // =====================================
    // EMPRESAS
    // =====================================

    match /empresas/{empresaId} {

      allow read: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario();

      allow create, update, delete: if false;
    }


    // =====================================
    // CONFIGURAÇÕES
    // =====================================

    match /configuracoes/{empresaId} {

      allow read: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update: if
        usuarioAtivo()
        && empresaId == idEmpresaUsuario()
        && resource.data.idEmpresa == idEmpresaUsuario()
        && request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if false;
    }

    match /printerServicePairings/{empresaId} {
      allow read, create, update, delete: if
        administrador() && empresaId == idEmpresaUsuario();
    }

    // O token secreto é o ID do documento e não pode ser lido nem listado.
    match /printerServiceUpdates/{empresaId}/services/{token} {
      allow read, delete: if false;
      allow create, update: if
        token == tokenPrinterService(empresaId)
        && request.resource.data.keys().hasOnly([
          "idEmpresa", "host", "port", "lastSeenAt"
        ])
        && request.resource.data.idEmpresa == empresaId
        && request.resource.data.host is string
        && request.resource.data.port is int
        && request.resource.data.port > 0
        && request.resource.data.port <= 65535
        && request.resource.data.lastSeenAt is timestamp;
    }

    match /printerServiceStatus/{empresaId} {
      allow read: if
        usuarioAtivo() && empresaId == idEmpresaUsuario();
      allow create: if
        registroPrinterServiceValido(empresaId)
        && request.resource.data.keys().hasOnly([
          "idEmpresa", "host", "port", "lastSeenAt"
        ])
        && request.resource.data.idEmpresa == empresaId
        && request.resource.data.host is string
        && request.resource.data.port is int
        && request.resource.data.lastSeenAt is timestamp;
      allow update: if
        registroPrinterServiceValido(empresaId)
        && request.resource.data.idEmpresa == empresaId
        && request.resource.data.host is string
        && request.resource.data.port is int
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "host", "port", "lastSeenAt"
        ]);
      allow delete: if false;
    }

// =====================================
// TOKENS DE NOTIFICAÇÃO PUSH
// =====================================

match /tokens/{tokenId} {

  // Usuário pode salvar/atualizar
  // somente o próprio token e dentro da própria empresa.
  allow create, update: if
    usuarioAtivo()
    &&
    request.resource.data.uid == request.auth.uid
    &&
    request.resource.data.idEmpresa == idEmpresaUsuario();

  // Usuário só pode consultar o próprio token.
  allow read: if
    usuarioAtivo()
    &&
    resource.data.uid == request.auth.uid;

  // Usuário só pode excluir o próprio token.
  allow delete: if
    usuarioAtivo()
    &&
    resource.data.uid == request.auth.uid;
}
    // =====================================
    // BLOQUEIO PADRÃO
    // =====================================

    match /{document=**} {

      allow read, write: if false;
    }

  }
}
