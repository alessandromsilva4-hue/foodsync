rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================
    // USUÁRIO LOGADO
    // =====================================

    function usuarioLogado() {
      return request.auth != null;
    }


    // =====================================
    // PERFIL DO USUÁRIO
    // =====================================

    function perfilUsuario() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      );
    }


    // =====================================
    // USUÁRIO ATIVO
    // =====================================

    function usuarioAtivo() {
      return usuarioLogado()
        &&
        perfilUsuario().data.status == "ativo";
    }


    // =====================================
    // EMPRESA DO USUÁRIO
    // =====================================

    function idEmpresaUsuario() {
      return perfilUsuario().data.idEmpresa;
    }


    // =====================================
    // PRODUTOS
    // MULTIEMPRESA
    // =====================================

    match /produtos/{produtoId} {

      // Ler somente produtos pertencentes
      // à empresa do usuário.
      allow read: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in resource.data.empresas;


      // Criar somente produtos vinculados
      // à empresa do usuário.
      allow create: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in request.resource.data.empresas;


      // Atualizar somente produtos que
      // pertencem à empresa do usuário.
      //
      // Também impede remover a empresa atual
      // do array durante a edição.
      allow update: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in resource.data.empresas
        &&
        idEmpresaUsuario() in request.resource.data.empresas;


      // Excluir somente produtos da empresa.
      allow delete: if
        usuarioAtivo()
        &&
        idEmpresaUsuario() in resource.data.empresas;
    }


    // =====================================
    // ESTOQUE
    // =====================================

    match /estoque/{estoqueId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();


      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow delete: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // PRODUÇÕES
    // =====================================

    match /producoes/{producaoId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();


      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow delete: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // MOVIMENTAÇÕES
    // =====================================

    match /movimentacoes/{movimentacaoId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();


      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow delete: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // ETIQUETAS
    // =====================================

    match /etiquetas/{etiquetaId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();


      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow delete: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // CONSULTAS PÚBLICAS DE ETIQUETAS
    // =====================================

    match /consultasPublicas/{codigoEtiqueta} {

      // QR Code pode consultar publicamente.
      allow read: if true;


      // Somente usuário ativo pode criar.
      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      // Nunca permitir alteração pública.
      allow update, delete: if false;
    }


    // =====================================
    // AUDITORIA
    // =====================================

    match /auditoria/{auditoriaId} {

      allow read: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();


      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      allow delete: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }

    // =====================================
    // SAC
    // =====================================

    match /sac/{chamadoId} {

      // ADMINISTRADOR PODE VISUALIZAR TODOS OS CHAMADOS
      allow read: if
        usuarioAtivo()
        &&
        perfilUsuario().data.perfil == "administrador";


      // USUÁRIO ATIVO PODE ABRIR CHAMADO
      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      // ADMINISTRADOR PODE ATENDER CHAMADOS
      allow update: if
        usuarioAtivo()
        &&
        perfilUsuario().data.perfil == "administrador";


      // NÃO PERMITIR EXCLUSÃO
      allow delete: if false;
    }
    // =====================================
    // USUÁRIOS
    // MULTIEMPRESA
    // =====================================

    match /usuarios/{userId} {

      // Usuário pode ler o próprio perfil.
      //
      // Administradores/usuários ativos também
      // podem ler usuários da própria empresa.
      allow read: if
        usuarioLogado()
        &&
        (
          userId == request.auth.uid
          ||
          (
            usuarioAtivo()
            &&
            resource.data.idEmpresa == idEmpresaUsuario()
          )
        );


      // Criar usuário somente na própria empresa.
      allow create: if
        usuarioAtivo()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      // Editar usuário da própria empresa.
      allow update: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();


      // Excluir usuário da própria empresa.
      allow delete: if
        usuarioAtivo()
        &&
        resource.data.idEmpresa == idEmpresaUsuario();
    }


    // =====================================
    // EMPRESAS
    // =====================================

    match /empresas/{empresaId} {

      // Usuário somente pode visualizar
      // sua própria empresa.
      allow read: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario();


      // Empresas não podem ser alteradas
      // pelo cliente.
      allow create, update, delete: if false;
    }

    // =====================================
    // CONFIGURAÇÕES DA EMPRESA
    // =====================================

    match /configuracoes/{empresaId} {

      allow read: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario();

      allow create: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow update: if
        usuarioAtivo()
        &&
        empresaId == idEmpresaUsuario()
        &&
        resource.data.idEmpresa == idEmpresaUsuario()
        &&
        request.resource.data.idEmpresa == idEmpresaUsuario();

      allow delete: if false;
    }
// =====================================
// SAC
// MULTIEMPRESA
// =====================================

match /sac/{chamadoId} {

  // Ler chamados
  allow read: if
    usuarioAtivo()
    &&
    (
      (
        perfilUsuario().data.perfil.lower() == "administrador"
        &&
        (
          resource.data.idEmpresa == idEmpresaUsuario()
          ||
          !("idEmpresa" in resource.data)
        )
      )
      ||
      (
        resource.data.idEmpresa == idEmpresaUsuario()
      )
    );


  // Criar chamado
  allow create: if
    usuarioAtivo()
    &&
    request.resource.data.idEmpresa == idEmpresaUsuario()
    &&
    request.resource.data.usuarioId == request.auth.uid;


  // Atualizar chamado
  allow update: if
    usuarioAtivo()
    &&
    perfilUsuario().data.perfil == "administrador"
    &&
    (
      resource.data.idEmpresa == idEmpresaUsuario()
      ||
      !("idEmpresa" in resource.data)
    );


  // Excluir chamado
  allow delete: if
    usuarioAtivo()
    &&
    perfilUsuario().data.perfil == "administrador"
    &&
    resource.data.idEmpresa == idEmpresaUsuario();

}

    // =====================================
    // BLOQUEAR TODO O RESTANTE
    // =====================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}
