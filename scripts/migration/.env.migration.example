# Copy to the repository root as .env.migration; the real file is gitignored.
FIREBASE_PROJECT_ID=foodsync-43a7e
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Server\AppData\Local\LotrixMigration\firebase-exporter.json
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-key

# Server-side migration credentials only. Never put these in a browser, APK or Git.
# Optional for direct Postgres operations. SQL migrations can instead be run
# from the Supabase Dashboard SQL Editor, and Firestore archive imports use REST.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_SECRET_KEY=sb_secret_replace-locally-never-commit
# For projects still using legacy API keys, use this instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=eyJ-replace-locally-never-commit
